  "modules": [
    {
      "file": "src/order.js",
      "lines": [
        "// src/order.js",
        "import { db } from './db.js'",
        "import { clamp } from './math.js'",
        "",
        "const TAX = 0.06",
        "const EMPTY = Object.freeze({ items: [], total: 0 })",
        "",
        "export async function loadOrder(id) {",
        "  if (!id) return null",
        "  const row = await db.orders.get(id)",
        "  if (!row) return EMPTY",
        "  return hydrate(row)",
        "}",
        "",
        "export function sumItems(items) {",
        "  const list = Array.isArray(items) ? items : []",
        "  const raw = list.reduce((s, it) => s + Number(it.price) * Number(it.qty), 0)",
        "  return clamp(raw, 0, 1e7)",
        "}",
        "",
        "function hydrate(row) {",
        "  const items = row.items ?? []",
        "  const sub = sumItems(items)",
        "  const tax = Math.round(sub * TAX * 100) / 100",
        "  return {",
        "    id: row.id,",
        "    items,",
        "    sub,",
        "    tax,",
        "    total: sub + tax,",
        "  }",
        "}",
        "",
        "export async function saveOrder(order) {",
        "  if (!order?.id) throw new Error('missing id')",
        "  const payload = { ...order, updatedAt: Date.now() }",
        "  await db.orders.put(payload)",
        "  return payload",
        "}"
      ]
    },
    {
      "file": "src/auth.js",
      "lines": [
        "// src/auth.js",
        "import { hash } from './crypto.js'",
        "import { users } from './db.js'",
        "",
        "const SESSION_MS = 1000 * 60 * 60 * 12",
        "",
        "export async function login(email, password) {",
        "  const user = await users.findByEmail(String(email || '').trim())",
        "  if (!user) return { ok: false, reason: 'missing' }",
        "  const digest = await hash(password)",
        "  if (digest !== user.passwordHash) return { ok: false, reason: 'bad' }",
        "  return {",
        "    ok: true,",
        "    token: crypto.randomUUID(),",
        "    exp: Date.now() + SESSION_MS,",
        "  }",
        "}",
        "",
        "export function guard(req) {",
        "  const token = req.headers.get('authorization') || ''",
        "  if (!token.startsWith('Bearer ')) return null",
        "  return token.slice(7)",
        "}",
        "",
        "export async function logout(token) {",
        "  if (!token) return",
        "  await users.revoke(token)",
        "}"
      ]
    },
    {
      "file": "src/cart.js",
      "lines": [
        "// src/cart.js",
        "import { loadSku } from './catalog.js'",
        "",
        "export function createCart() {",
        "  return { lines: [], coupon: null }",
        "}",
        "",
        "export async function addLine(cart, skuId, qty) {",
        "  const n = Math.max(1, Number(qty) || 1)",
        "  const sku = await loadSku(skuId)",
        "  if (!sku) return cart",
        "  const found = cart.lines.find((row) => row.skuId === sku.id)",
        "  if (found) {",
        "    found.qty += n",
        "    return cart",
        "  }",
        "  cart.lines.push({ skuId: sku.id, name: sku.name, price: sku.price, qty: n })",
        "  return cart",
        "}",
        "",
        "export function applyCoupon(cart, code) {",
        "  const key = String(code || '').toUpperCase()",
        "  if (!key) return cart",
        "  cart.coupon = key",
        "  return cart",
        "}",
        "",
        "export function cartTotal(cart) {",
        "  const sum = cart.lines.reduce((s, row) => s + row.price * row.qty, 0)",
        "  if (cart.coupon === 'SAVE10') return Math.round(sum * 0.9)",
        "  return sum",
        "}"
      ]
    },
    {
      "file": "src/api.js",
      "lines": [
        "// src/api.js",
        "const BASE = '/api/v1'",
        "",
        "async function request(path, opt = {}) {",
        "  const res = await fetch(BASE + path, {",
        "    method: opt.method || 'GET',",
        "    headers: {",
        "      'Content-Type': 'application/json',",
        "      ...(opt.headers || {}),",
        "    },",
        "    body: opt.body ? JSON.stringify(opt.body) : undefined,",
        "    signal: opt.signal,",
        "  })",
        "  if (!res.ok) throw new Error(res.statusText)",
        "  return res.json()",
        "}",
        "",
        "export const api = {",
        "  get: (path, opt) => request(path, opt),",
        "  post: (path, body, opt) => request(path, { ...opt, method: 'POST', body }),",
        "  del: (path, opt) => request(path, { ...opt, method: 'DELETE' }),",
        "}"
      ]
    },
    {
      "file": "src/app.js",
      "lines": [
        "// src/app.js",
        "import { loadOrder, saveOrder } from './order.js'",
        "import { login, guard } from './auth.js'",
        "import { addLine, cartTotal } from './cart.js'",
        "",
        "const root = document.getElementById('app')",
        "",
        "export async function boot() {",
        "  const token = guard({ headers: new Headers() })",
        "  if (!token) {",
        "    root.dataset.view = 'login'",
        "    return",
        "  }",
        "  root.dataset.view = 'desk'",
        "  await refresh()",
        "}",
        "",
        "async function refresh() {",
        "  const id = new URL(location.href).searchParams.get('order')",
        "  const order = id ? await loadOrder(id) : null",
        "  render(order)",
        "}",
        "",
        "function render(order) {",
        "  const total = order ? order.total : 0",
        "  root.querySelector('#total').textContent = String(total)",
        "}",
        "",
        "boot().catch((err) => console.error(err))"
      ]
    }
  ]
}
